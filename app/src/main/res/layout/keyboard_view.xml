<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#2c2c2c"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- ============================================ -->
    <!-- نوار جستجو و دکمه تنظیمات -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#3A3A3A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/kbEditSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="جستجو..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textDirection="rtl"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/kbBtnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="تنظیمات"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- تب‌های اخیر / علاقه‌مندی / دسته‌ها -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/kbTabRecent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#3A3A3A"
            android:gravity="center"
            android:text="اخیر"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/kbTabFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#3A3A3A"
            android:gravity="center"
            android:text="علاقه‌مندی"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/kbTabCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#3A3A3A"
            android:gravity="center"
            android:text="دسته‌ها"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- اسکرول دسته‌ها (با LinearLayout جایگزین ChipGroup) -->
    <!-- ============================================ -->
    <HorizontalScrollView
        android:id="@+id/kbCategoryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/kbChipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />
    </HorizontalScrollView>

    <!-- ============================================ -->
    <!-- ردیف 1: اعداد -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:text="1" style="@style/KeyButton" android:tag="1" />
        <Button android:text="2" style="@style/KeyButton" android:tag="2" />
        <Button android:text="3" style="@style/KeyButton" android:tag="3" />
        <Button android:text="4" style="@style/KeyButton" android:tag="4" />
        <Button android:text="5" style="@style/KeyButton" android:tag="5" />
        <Button android:text="6" style="@style/KeyButton" android:tag="6" />
        <Button android:text="7" style="@style/KeyButton" android:tag="7" />
        <Button android:text="8" style="@style/KeyButton" android:tag="8" />
        <Button android:text="9" style="@style/KeyButton" android:tag="9" />
        <Button android:text="0" style="@style/KeyButton" android:tag="0" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- ردیف 2: QWERTY (انگلیسی) -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button android:text="q" style="@style/KeyButton" android:tag="q" />
        <Button android:text="w" style="@style/KeyButton" android:tag="w" />
        <Button android:text="e" style="@style/KeyButton" android:tag="e" />
        <Button android:text="r" style="@style/KeyButton" android:tag="r" />
        <Button android:text="t" style="@style/KeyButton" android:tag="t" />
        <Button android:text="y" style="@style/KeyButton" android:tag="y" />
        <Button android:text="u" style="@style/KeyButton" android:tag="u" />
        <Button android:text="i" style="@style/KeyButton" android:tag="i" />
        <Button android:text="o" style="@style/KeyButton" android:tag="o" />
        <Button android:text="p" style="@style/KeyButton" android:tag="p" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- ردیف 3: ASDF (انگلیسی) -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button android:text="a" style="@style/KeyButton" android:tag="a" />
        <Button android:text="s" style="@style/KeyButton" android:tag="s" />
        <Button android:text="d" style="@style/KeyButton" android:tag="d" />
        <Button android:text="f" style="@style/KeyButton" android:tag="f" />
        <Button android:text="g" style="@style/KeyButton" android:tag="g" />
        <Button android:text="h" style="@style/KeyButton" android:tag="h" />
        <Button android:text="j" style="@style/KeyButton" android:tag="j" />
        <Button android:text="k" style="@style/KeyButton" android:tag="k" />
        <Button android:text="l" style="@style/KeyButton" android:tag="l" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- ردیف 4: ZXCV (انگلیسی) -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button android:text="z" style="@style/KeyButton" android:tag="z" />
        <Button android:text="x" style="@style/KeyButton" android:tag="x" />
        <Button android:text="c" style="@style/KeyButton" android:tag="c" />
        <Button android:text="v" style="@style/KeyButton" android:tag="v" />
        <Button android:text="b" style="@style/KeyButton" android:tag="b" />
        <Button android:text="n" style="@style/KeyButton" android:tag="n" />
        <Button android:text="m" style="@style/KeyButton" android:tag="m" />
        <Button android:text="?" style="@style/KeyButton" android:tag="?" />
        <Button android:text="!" style="@style/KeyButton" android:tag="!" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- ردیف 5: فارسی (ا تا خ) -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button android:text="ا" style="@style/KeyButton" android:tag="ا" />
        <Button android:text="ب" style="@style/KeyButton" android:tag="ب" />
        <Button android:text="پ" style="@style/KeyButton" android:tag="پ" />
        <Button android:text="ت" style="@style/KeyButton" android:tag="ت" />
        <Button android:text="ث" style="@style/KeyButton" android:tag="ث" />
        <Button android:text="ج" style="@style/KeyButton" android:tag="ج" />
        <Button android:text="چ" style="@style/KeyButton" android:tag="چ" />
        <Button android:text="ح" style="@style/KeyButton" android:tag="ح" />
        <Button android:text="خ" style="@style/KeyButton" android:tag="خ" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- ردیف 6: فارسی (د تا غ) -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button android:text="د" style="@style/KeyButton" android:tag="د" />
        <Button android:text="ذ" style="@style/KeyButton" android:tag="ذ" />
        <Button android:text="ر" style="@style/KeyButton" android:tag="ر" />
        <Button android:text="ز" style="@style/KeyButton" android:tag="ز" />
        <Button android:text="ژ" style="@style/KeyButton" android:tag="ژ" />
        <Button android:text="س" style="@style/KeyButton" android:tag="س" />
        <Button android:text="ش" style="@style/KeyButton" android:tag="ش" />
        <Button android:text="ص" style="@style/KeyButton" android:tag="ص" />
        <Button android:text="ض" style="@style/KeyButton" android:tag="ض" />
        <Button android:text="ط" style="@style/KeyButton" android:tag="ط" />
        <Button android:text="ظ" style="@style/KeyButton" android:tag="ظ" />
        <Button android:text="ع" style="@style/KeyButton" android:tag="ع" />
        <Button android:text="غ" style="@style/KeyButton" android:tag="غ" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- ردیف 7: فارسی (ف تا ی) -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button android:text="ف" style="@style/KeyButton" android:tag="ف" />
        <Button android:text="ق" style="@style/KeyButton" android:tag="ق" />
        <Button android:text="ک" style="@style/KeyButton" android:tag="ک" />
        <Button android:text="گ" style="@style/KeyButton" android:tag="گ" />
        <Button android:text="ل" style="@style/KeyButton" android:tag="ل" />
        <Button android:text="م" style="@style/KeyButton" android:tag="م" />
        <Button android:text="ن" style="@style/KeyButton" android:tag="ن" />
        <Button android:text="و" style="@style/KeyButton" android:tag="و" />
        <Button android:text="ه" style="@style/KeyButton" android:tag="ه" />
        <Button android:text="ی" style="@style/KeyButton" android:tag="ی" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- ردیف 8: دکمه‌های کنترل (Shift, Space, Backspace, Enter) -->
    <!-- ============================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <Button android:text="⇧" style="@style/KeyButtonCtrl" android:tag="shift" />
        <Button android:text="⌫" style="@style/KeyButtonCtrl" android:tag="backspace" />
        <Button android:text="Space" style="@style/KeyButtonSpace" android:tag="space" />
        <Button android:text="↵" style="@style/KeyButtonCtrl" android:tag="enter" />
    </LinearLayout>

    <!-- ============================================ -->
    <!-- RecyclerView و TextView خالی -->
    <!-- ============================================ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/kbRecyclerPins"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/kbTextEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="موردی وجود ندارد"
        android:textColor="#888888"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
