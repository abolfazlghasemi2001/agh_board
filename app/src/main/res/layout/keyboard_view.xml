<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#2c2c2c"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- نوار جستجو (با آی‌دی مورد نیاز) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#444444"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/kbEditSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="جستجو..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textDirection="rtl"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/kbBtnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="تنظیمات"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- تب‌ها (با آی‌دی‌های مورد نیاز) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/kbTabRecent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#444444"
            android:gravity="center"
            android:text="اخیر"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/kbTabFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#444444"
            android:gravity="center"
            android:text="علاقه‌مندی"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/kbTabCategories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#444444"
            android:gravity="center"
            android:text="دسته‌ها"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- اسکرول دسته‌ها -->
    <HorizontalScrollView
        android:id="@+id/kbCategoryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/kbChipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- ردیف اول: اعداد -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:text="1" style="@style/KeyButton" />
        <Button android:text="2" style="@style/KeyButton" />
        <Button android:text="3" style="@style/KeyButton" />
        <Button android:text="4" style="@style/KeyButton" />
        <Button android:text="5" style="@style/KeyButton" />
        <Button android:text="6" style="@style/KeyButton" />
        <Button android:text="7" style="@style/KeyButton" />
        <Button android:text="8" style="@style/KeyButton" />
        <Button android:text="9" style="@style/KeyButton" />
        <Button android:text="0" style="@style/KeyButton" />
    </LinearLayout>

    <!-- ردیف دوم: حروف انگلیسی (qwerty) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:text="q" style="@style/KeyButton" />
        <Button android:text="w" style="@style/KeyButton" />
        <Button android:text="e" style="@style/KeyButton" />
        <Button android:text="r" style="@style/KeyButton" />
        <Button android:text="t" style="@style/KeyButton" />
        <Button android:text="y" style="@style/KeyButton" />
        <Button android:text="u" style="@style/KeyButton" />
        <Button android:text="i" style="@style/KeyButton" />
        <Button android:text="o" style="@style/KeyButton" />
        <Button android:text="p" style="@style/KeyButton" />
    </LinearLayout>

    <!-- ردیف سوم: حروف انگلیسی (asdfghjkl) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:text="a" style="@style/KeyButton" />
        <Button android:text="s" style="@style/KeyButton" />
        <Button android:text="d" style="@style/KeyButton" />
        <Button android:text="f" style="@style/KeyButton" />
        <Button android:text="g" style="@style/KeyButton" />
        <Button android:text="h" style="@style/KeyButton" />
        <Button android:text="j" style="@style/KeyButton" />
        <Button android:text="k" style="@style/KeyButton" />
        <Button android:text="l" style="@style/KeyButton" />
    </LinearLayout>

    <!-- ردیف چهارم: حروف فارسی (ا تا خ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:text="ا" style="@style/KeyButton" />
        <Button android:text="ب" style="@style/KeyButton" />
        <Button android:text="پ" style="@style/KeyButton" />
        <Button android:text="ت" style="@style/KeyButton" />
        <Button android:text="ث" style="@style/KeyButton" />
        <Button android:text="ج" style="@style/KeyButton" />
        <Button android:text="چ" style="@style/KeyButton" />
        <Button android:text="ح" style="@style/KeyButton" />
        <Button android:text="خ" style="@style/KeyButton" />
    </LinearLayout>

    <!-- ردیف پنجم: دکمه‌های کنترل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:text="⇧" style="@style/KeyButtonCtrl" />
        <Button android:text="Space" style="@style/KeyButtonSpace" />
        <Button android:text="⌫" style="@style/KeyButtonCtrl" />
        <Button android:text="↵" style="@style/KeyButtonCtrl" />
    </LinearLayout>

    <!-- RecyclerView برای نمایش پین‌ها (با آی‌دی مورد نیاز) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/kbRecyclerPins"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- متن خالی (با آی‌دی مورد نیاز) -->
    <TextView
        android:id="@+id/kbTextEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="موردی وجود ندارد"
        android:textColor="#888888"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
